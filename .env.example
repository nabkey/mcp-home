# At least one front door is required: Cloudflare (CF_*) and/or Tailscale (TS_*).

# Cloudflare Tunnel (all four required if any is set)
# Create an API token at https://dash.cloudflare.com/profile/api-tokens
# with Tunnel:Edit, DNS:Edit, and Access: Organizations/Apps (Read) permissions.
CF_API_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_ZONE_ID=your-dns-zone-id
CF_HOSTNAME=mcp.yourdomain.com
# CF_TUNNEL_NAME=mcp-server
#
# Authentication: the server auto-discovers the Cloudflare Access team domain
# and application AUD at startup using the API token above. You need a
# self_hosted Access application on CF_HOSTNAME with:
#   - An identity policy (e.g. email allowlist)
#   - OAuth configuration enabled with dynamic client registration
# Create one in Zero Trust dashboard > Access > Applications > Self-hosted.
# Pass --insecure to skip auth on this listener (DANGEROUS: exposes server
# without auth). It does not affect the Tailscale listener.

# Tailscale (optional; enough on its own). A tagged, reusable auth key makes
# the server join the tailnet as TS_HOSTNAME and serve /mcp on :443 with a
# Tailscale cert. Callers are checked with WhoIs against the allowlists; at
# least one of TS_ALLOWED_TAGS / TS_ALLOWED_LOGINS must be set. The tailnet
# needs MagicDNS + HTTPS certificates enabled and an ACL admitting the
# callers on 443. Persist TS_STATE_DIR or the node re-registers every start.
# TS_AUTHKEY=tskey-auth-...
# TS_HOSTNAME=mcp-home
# TS_STATE_DIR=/home/nonroot/tsstate
# TS_ALLOWED_TAGS=tag:voice-agent
# TS_ALLOWED_LOGINS=you@example.com

# Log level: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# Home Assistant (optional — both required if either is set)
# HASS_URL=http://homeassistant.local:8123
# HASS_TOKEN=your-long-lived-access-token
# Refuse specific services regardless of what the assistant is asked.
# Patterns are domain.service; either part may be *.
# HASS_DENY_SERVICES=lock.unlock,alarm_control_panel.*

# Sonarr (optional — both required if either is set)
# SONARR_URL=http://localhost:8989
# SONARR_API_KEY=your-sonarr-api-key

# Radarr (optional — both required if either is set)
# RADARR_URL=http://localhost:7878
# RADARR_API_KEY=your-radarr-api-key

# Frigate NVR (optional)
# FRIGATE_URL=http://localhost:5000

# ESPHome dashboard (optional — the HA ESPHome add-on, typically on port 6052)
# ESPHOME_URL=http://homeassistant.local:6052
# ESPHOME_PASSWORD=only-if-dashboard-auth-is-enabled
